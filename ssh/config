# -*- mode: conf-space -*-

Include ../dotfiles-${UNAME}/ssh/config
Include ../dotfiles-${DOMAIN}/ssh/config
Include ../dotfiles-${HOST_SHORT}/ssh/config

Host *
  VerifyHostKeyDNS yes

Host github
  HostName github.com
  User     git

Match exec "test -S ~/.ssh/agent.sock"
  IdentityAgent ~/.ssh/agent.sock
